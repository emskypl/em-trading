<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EmTrading.Wpf.Controls">

    <Style TargetType="{x:Type local:KpiCard}">
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:KpiCard}">
                    <Border Background="White" CornerRadius="5" Padding="10,8" BorderBrush="#E0E0E3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Title}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{TemplateBinding Value}" FontSize="18" FontWeight="Bold" Foreground="{TemplateBinding Accent}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:SymbolBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SymbolBox}">
                    <Grid>
                        <TextBox x:Name="PART_TextBox"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                        <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_TextBox}" Placement="Bottom"
                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="None"
                               MinWidth="{Binding ActualWidth, ElementName=PART_TextBox}">
                            <Border Background="White" BorderBrush="#C8C8CC" BorderThickness="1" Margin="0,1,6,6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <ListBox x:Name="PART_List" MaxHeight="320" MinWidth="280" BorderThickness="0" Focusable="False"
                                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Padding" Value="6,3" />
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Symbol}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:SymbolSuggestion}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="Gray" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
