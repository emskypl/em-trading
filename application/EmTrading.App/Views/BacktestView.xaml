<UserControl x:Class="EmTrading.App.Views.BacktestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EmTrading.Presentation.Localization;assembly=EmTrading.Presentation"
             xmlns:controls="clr-namespace:EmTrading.Wpf.Controls;assembly=EmTrading.Wpf.Controls"
             xmlns:charts="clr-namespace:EmTrading.Wpf.Controls.Charts;assembly=EmTrading.Wpf.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Inputs -->
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <ScrollViewer Style="{StaticResource FormScrollViewer}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Backtest_Title}" Style="{StaticResource PageTitle}" />

                    <TextBlock Text="{loc:Tr Field_Symbol}" Style="{StaticResource FieldLabel}" />
                    <controls:SymbolBox Text="{Binding Symbol, ValidatesOnNotifyDataErrors=True}"
                                        SuggestionProvider="{StaticResource DownloadedSymbolSuggestions}" ToolTip="{loc:Tr Symbol_SearchHint}"
                                        AutomationProperties.Name="{loc:Tr Field_Symbol}" />

                    <TextBlock Text="{loc:Tr Field_StartDate}" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding StartDate}" />
                    <TextBlock Text="{loc:Tr Field_EndDate}" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding EndDate}" />

                    <TextBlock Text="{loc:Tr Field_InitialCapital}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding InitialCapital, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                    <TextBlock Text="{loc:Tr Field_Strategy}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}"
                              DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedStrategy.Description}">
                        <!-- Without this, screen readers and UI automation see the record's ToString(). -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <!-- Generated from the strategy's [StrategyParameter] declarations. -->
                    <ItemsControl ItemsSource="{Binding StrategyParameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding Hint}">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource NegativeBrush}" FontSize="10" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{loc:Tr Backtest_Run}" Command="{Binding RunBacktestCommand}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,6" />
                    <UniformGrid Columns="2">
                        <Button Content="{loc:Tr Backtest_LoadLatest}" Command="{Binding LoadLatestResultsCommand}" Margin="0,0,3,0" />
                        <Button Content="{loc:Tr Common_Cancel}" Command="{Binding CancelCommand}" Margin="3,0,0,0" />
                    </UniformGrid>

                    <Separator Margin="0,16,0,4" />
                    <TextBlock Text="{loc:Tr Backtest_BatchTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{loc:Tr Field_SymbolList}" Style="{StaticResource FieldLabel}" />
                    <controls:SymbolBox Text="{Binding SymbolList}" AllowMultiple="True"
                                        SuggestionProvider="{StaticResource DownloadedSymbolSuggestions}" ToolTip="{loc:Tr Backtest_BatchHint}"
                                        AutomationProperties.Name="{loc:Tr Field_SymbolList}" />
                    <Button Content="{loc:Tr Backtest_RunBatch}" Command="{Binding RunBacktestBatchCommand}" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Report -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Both values come from the style: a local Text value would override the trigger. -->
            <TextBlock Foreground="Gray" Margin="3,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding ReportTitle}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReportTitle}" Value="{x:Null}">
                                <Setter Property="Text" Value="{loc:Tr Backtest_NoReport}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,8">
                <controls:KpiCard Title="{loc:Tr Kpi_AnnualReturn}" Value="{Binding CompoundingReturn}" Accent="{StaticResource PositiveBrush}" />
                <controls:KpiCard Title="{loc:Tr Kpi_MaxDrawdown}" Value="{Binding MaxDrawdown}" Accent="{StaticResource NegativeBrush}" />
                <controls:KpiCard Title="{loc:Tr Kpi_WinRate}" Value="{Binding WinRate}" Accent="{StaticResource AccentBrush}" />
                <controls:KpiCard Title="{loc:Tr Kpi_ProfitFactor}" Value="{Binding ProfitFactor}" Accent="{StaticResource PositiveBrush}" />
                <controls:KpiCard Title="{loc:Tr Kpi_Sharpe}" Value="{Binding SharpeRatio}" />
                <controls:KpiCard Title="{loc:Tr Kpi_Trades}" Value="{Binding TotalTrades}" />
            </UniformGrid>

            <TabControl Grid.Row="2" Background="White">
                <TabItem Header="{loc:Tr Backtest_TabEquity}">
                    <charts:EquityChart Points="{Binding Equity}"
                                        EquityLabel="{loc:Tr Chart_Equity}" DrawdownLabel="{loc:Tr Chart_Drawdown}" />
                </TabItem>
                <TabItem Header="{loc:Tr Backtest_TabPrice}">
                    <charts:PriceChart Bars="{Binding PriceBars}" Trades="{Binding TradeMarkers}" PriceLabel="{loc:Tr Chart_Price}" />
                </TabItem>
                <TabItem Header="{loc:Tr Backtest_TabTrades}">
                    <DataGrid ItemsSource="{Binding Trades}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                            <DataGridTextColumn Header="{loc:Tr Trades_Direction}" Binding="{Binding Direction, Converter={StaticResource LocalizedEnum}}" Width="80" />
                            <DataGridTextColumn Header="{loc:Tr Trades_EntryTime}" Binding="{Binding EntryTime, StringFormat=g}" Width="130" />
                            <DataGridTextColumn Header="{loc:Tr Trades_EntryPrice}" Binding="{Binding EntryPrice, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="{loc:Tr Trades_ExitTime}" Binding="{Binding ExitTime, StringFormat=g}" Width="130" />
                            <DataGridTextColumn Header="{loc:Tr Trades_ExitPrice}" Binding="{Binding ExitPrice, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="{loc:Tr Trades_ExitReason}" Binding="{Binding ExitReason}" Width="140" />
                            <DataGridTextColumn Header="{loc:Tr Trades_ProfitLoss}" Binding="{Binding ProfitLoss, StringFormat=N2}" Width="100" />
                            <DataGridTextColumn Header="{loc:Tr Trades_ProfitLossPercent}" Binding="{Binding ProfitLossPercent, StringFormat=P2}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{loc:Tr Backtest_TabAnalysis}">
                    <Grid Margin="16" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:Tr Analysis_AverageWin}" Foreground="Gray" />
                        <TextBlock Grid.Column="1" Text="{Binding AverageWin}" Foreground="{StaticResource PositiveBrush}" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Text="{loc:Tr Analysis_AverageLoss}" Foreground="Gray" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AverageLoss}" Foreground="{StaticResource NegativeBrush}" FontWeight="Bold" />
                        <TextBlock Grid.Row="2" Text="{loc:Tr Analysis_MaxWins}" Foreground="Gray" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MaxConsecutiveWins}" FontWeight="Bold" />
                        <TextBlock Grid.Row="3" Text="{loc:Tr Analysis_MaxLosses}" Foreground="Gray" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MaxConsecutiveLosses}" FontWeight="Bold" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
