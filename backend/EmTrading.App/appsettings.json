{
  "Storage": {
    "DataFolder": "",
    "ResultsFolder": "",
    "DatabaseFile": ""
  },
  "Alpaca": {
    "DataBaseUrl": "https://data.alpaca.markets",
    "Feed": "iex",
    "RequestsPerMinute": 200,
    "TradingMode": "Paper",
    "LiveTradingEnabled": false,
    "MarketDataStreamUrl": "wss://stream.data.alpaca.markets/v2",
    "ReconcileIntervalSeconds": 30
  },
  "Trading": {
    "Risk": {
      "TradingEnabled": true,
      "MaxOrderNotional": 10000,
      "MaxPositionNotional": 25000,
      "MaxDailyLoss": 1000,
      "MaxOpenOrders": 10
    }
  },
  "Jobs": {
    "MaxParallelJobs": 3
  },
  "Lean": {
    "EngineRunnerPath": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Debug", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Debug" },
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/EmTrading/logs/emtrading-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
