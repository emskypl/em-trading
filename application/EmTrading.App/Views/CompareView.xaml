<UserControl x:Class="EmTrading.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EmTrading.Presentation.Localization;assembly=EmTrading.Presentation"
             xmlns:controls="clr-namespace:EmTrading.Wpf.Controls;assembly=EmTrading.Wpf.Controls"
             xmlns:charts="clr-namespace:EmTrading.Wpf.Controls.Charts;assembly=EmTrading.Wpf.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Run one strategy over a symbol list -->
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <ScrollViewer Style="{StaticResource FormScrollViewer}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Compare_Title}" Style="{StaticResource PageTitle}" />

                    <TextBlock Text="{loc:Tr Field_Strategy}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}"
                              ItemTemplate="{StaticResource StrategyNameItem}" ItemContainerStyle="{StaticResource StrategyComboItem}"
                              ToolTip="{Binding SelectedStrategy, Converter={StaticResource StrategyText}, ConverterParameter=Description}" />

                    <TextBlock Text="{loc:Tr Field_SymbolList}" Style="{StaticResource FieldLabel}" />
                    <controls:SymbolBox Text="{Binding SymbolList}" AllowMultiple="True"
                                        SuggestionProvider="{StaticResource SymbolSuggestions}" ToolTip="{loc:Tr Compare_SymbolsHint}"
                                        AutomationProperties.Name="{loc:Tr Field_SymbolList}" />

                    <TextBlock Text="{loc:Tr Field_StartDate}" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding StartDate}" />
                    <TextBlock Text="{loc:Tr Field_EndDate}" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding EndDate}" />

                    <TextBlock Text="{loc:Tr Field_InitialCapital}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding InitialCapital, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="{loc:Tr Compare_DownloadData}" Command="{Binding DownloadDataCommand}" Margin="0,16,0,6" />
                    <Button Content="{loc:Tr Compare_RunBacktests}" Command="{Binding RunBacktestsCommand}" Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="{loc:Tr Compare_RunHint}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Ranking -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="140" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="120" />
            </Grid.RowDefinitions>

            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="{loc:Tr Compare_Ranking}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <CheckBox Content="{loc:Tr Compare_AllStrategies}" IsChecked="{Binding AllStrategies}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <CheckBox Content="{loc:Tr Compare_LatestOnly}" IsChecked="{Binding LatestOnly}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <CheckBox Content="{loc:Tr Compare_OnlyListed}" IsChecked="{Binding OnlyListedSymbols}" VerticalAlignment="Center" Margin="0,0,12,0" />
            </WrapPanel>

            <StackPanel Grid.Row="1" Style="{StaticResource Toolbar}">
                <Button Content="{loc:Tr Common_Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                <Button Content="{loc:Tr Compare_ChartSelected}" Command="{Binding ChartSelectedCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=RankingGrid}" ToolTip="{loc:Tr Compare_ChartHint}" Margin="0,0,6,0" />
                <Button Content="{loc:Tr History_Open}" Command="{Binding OpenSelectedCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=RankingGrid}" Margin="0,0,6,0" />
                <Button Content="{loc:Tr Compare_AskAssistant}" Command="{Binding AskAssistantCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=RankingGrid}" ToolTip="{loc:Tr Compare_AskAssistantHint}" />
            </StackPanel>

            <Grid Grid.Row="2">
                <DataGrid x:Name="RankingGrid" ItemsSource="{Binding Runs}" SelectionMode="Extended">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenSelectedCommand}"
                                      CommandParameter="{Binding SelectedItems, ElementName=RankingGrid}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Tr Field_Symbol}" Binding="{Binding Symbol}" Width="70" />
                        <DataGridTextColumn Header="{loc:Tr Field_Strategy}" Binding="{Binding StrategyName, Converter={StaticResource StrategyText}}" Width="140" />
                        <DataGridTextColumn Header="{loc:Tr Compare_NetProfit}" Binding="{Binding NetProfitPercent, StringFormat=N2}" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="{loc:Tr Compare_MaxDrawdown}" Binding="{Binding MaxDrawdownPercent, StringFormat=N2}" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="{loc:Tr Compare_ReturnOverDrawdown}" Binding="{Binding ReturnOverDrawdown, StringFormat=N2}" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="{loc:Tr Kpi_Sharpe}" Binding="{Binding SharpeRatio, StringFormat=N2}" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="{loc:Tr Compare_WinRate}" Binding="{Binding WinRatePercent, StringFormat=N1}" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="{loc:Tr Kpi_ProfitFactor}" Binding="{Binding ProfitFactor, StringFormat=N2}" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="{loc:Tr Kpi_Trades}" Binding="{Binding TotalTrades}" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="{loc:Tr Field_StartDate}" Binding="{Binding Start, StringFormat=d}" Width="85" />
                        <DataGridTextColumn Header="{loc:Tr Field_EndDate}" Binding="{Binding End, StringFormat=d}" Width="85" />
                        <DataGridTextColumn Header="{loc:Tr History_Created}" Binding="{Binding CreatedAt.LocalDateTime, StringFormat=g}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{loc:Tr Compare_Empty}" TextWrapping="Wrap" Foreground="Gray" Margin="16,48,16,0" HorizontalAlignment="Center"
                           TextAlignment="Center" MaxWidth="460" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRuns}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="4">
                <charts:MultiSeriesChart Series="{Binding ChartSeries}" ShowPercent="True" ValueLabel="{loc:Tr Chart_CumulativeReturn}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
