<Window x:Class="EmTrading.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:local="clr-namespace:EmTrading.App"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="800" Width="1250"
        Background="#F4F5F7">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E3" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="PARAMETRY WEJŚCIOWE" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,0,0,15" />

                        <!-- Sekcja 1: Aktywo i Czas -->
                        <GroupBox Header="Aktywo i Zakres Czasu" Margin="0,0,0,15" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Symbol:" Margin="0,5,0,2" FontSize="11" Foreground="Gray"/>
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding Symbols}"
                                          Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Interwał pobieranych danych:" Margin="0,8,0,2" FontSize="11" Foreground="Gray"/>
                                <ComboBox ItemsSource="{Binding Timeframes}" SelectedItem="{Binding SelectedTimeframe}" />

                                <TextBlock Text="Data Od:" Margin="0,8,0,2" FontSize="11" Foreground="Gray"/>
                                <DatePicker SelectedDate="{Binding StartDate}" />

                                <TextBlock Text="Data Do:" Margin="0,8,0,2" FontSize="11" Foreground="Gray"/>
                                <DatePicker SelectedDate="{Binding EndDate}" />
                            </StackPanel>
                        </GroupBox>

                        <!-- Sekcja 2: Strategia -->
                        <GroupBox Header="Strategia i Wskaźniki" Margin="0,0,0,15" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Wybór Strategii:" Margin="0,5,0,2" FontSize="11" Foreground="Gray"/>
                                <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="{Binding SelectedStrategy.Description}">
                                    <!-- Without this, screen readers and UI automation see the record's ToString(). -->
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>

                                <!-- Generated from the strategy's parameter declarations ([StrategyParameter] attributes). -->
                                <ItemsControl ItemsSource="{Binding StrategyParameters}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4,0,0" ToolTip="{Binding Hint}">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="Gray"/>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                                                <TextBlock Text="{Binding Error}" Foreground="#C62828" FontSize="10" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <!-- Sekcja 3: Zarządzanie Kapitałem i Ryzykiem -->
                        <GroupBox Header="Kapitał" Margin="0,0,0,15" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Kapitał Początkowy ($):" Margin="0,5,0,2" FontSize="11" Foreground="Gray"/>
                                <TextBox Text="{Binding InitialCapital}" Padding="4"/>

                            </StackPanel>
                        </GroupBox>

                        <!-- Akcje / Przyciski -->
                        <TextBlock Text="Symbole (lista, oddzielone przecinkami):" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SymbolList, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,6"
                                 ToolTip="Pobieranie danych i backtesty w tle: każdy symbol to osobne zadanie. Pobierane są tylko brakujące dni; SPY (benchmark) jest dodawany automatycznie."/>
                        <Button Content="1. Pobierz dane"
                                Command="{Binding DownloadDataCommand}"
                                Padding="8" Margin="0,0,0,8" Height="34"/>

                        <Button Content="2. Uruchom Backtest"
                                Command="{Binding RunBacktestCommand}"
                                Background="#1565C0" Foreground="White" FontWeight="Bold"
                                Padding="8" Margin="0,0,0,8" Height="36"/>

                        <Button Content="Backtest w tle dla listy"
                                Command="{Binding RunBacktestBatchCommand}"
                                ToolTip="Uruchamia wybraną strategię dla każdego symbolu z listy jako równoległe zadania w tle."
                                Padding="6" Margin="0,0,0,8" Height="30"/>

                        <Button Content="Wczytaj Zapisane Wyniki"
                                Command="{Binding LoadLatestResultsCommand}"
                                Padding="6" Margin="0,0,0,8" Height="30"/>

                        <Button Content="Anuluj"
                                Command="{Binding CancelCommand}"
                                Padding="6" Height="30"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ================= MAIN CONTENT: WYNIKI I ANALLIZA ================= -->
            <Grid Grid.Column="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Panel KPI (Karty wyników) -->
                <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,15">
                    <Border Background="White" CornerRadius="5" Margin="3" Padding="8" BorderBrush="#E0E0E3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Stopa zwrotu" FontSize="11" Foreground="Gray" />
                            <TextBlock Text="{Binding CompoundingReturn}" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="5" Margin="3" Padding="8" BorderBrush="#E0E0E3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Max DD" FontSize="11" Foreground="Gray" />
                            <TextBlock Text="{Binding MaxDrawdown}" FontSize="18" FontWeight="Bold" Foreground="#C62828" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="5" Margin="3" Padding="8" BorderBrush="#E0E0E3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Win Rate" FontSize="11" Foreground="Gray" />
                            <TextBlock Text="{Binding WinRate}" FontSize="18" FontWeight="Bold" Foreground="#1565C0" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="5" Margin="3" Padding="8" BorderBrush="#E0E0E3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Profit Factor" FontSize="11" Foreground="Gray" />
                            <TextBlock Text="{Binding ProfitFactor}" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="5" Margin="3" Padding="8" BorderBrush="#E0E0E3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Sharpe Ratio" FontSize="11" Foreground="Gray" />
                            <TextBlock Text="{Binding SharpeRatio}" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="5" Margin="3" Padding="8" BorderBrush="#E0E0E3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Transakcje" FontSize="11" Foreground="Gray" />
                            <TextBlock Text="{Binding TotalTrades}" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Zakładki Szczegółowej Analizy -->
                <TabControl Grid.Row="1" Background="White" BorderBrush="#E0E0E3" SelectedIndex="{Binding SelectedTabIndex}">
                    
                    <!-- Zakładka 1: Wykres Portfela -->
                    <TabItem Header="Wykres Equity">
                        <Grid>
                            <lvc:CartesianChart Series="{Binding EquitySeriesCollection}" LegendLocation="None">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Data transakcji" Labels="{Binding ChartLabels}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Step="50" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Wartość portfela ($)" LabelFormatter="{Binding EquityFormatter}" />
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </TabItem>

                    <!-- Zakładka 2: Dziennik Transakcji -->
                    <TabItem Header="Dziennik Transakcji">
                        <DataGrid ItemsSource="{Binding TradesHistory}" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  Background="White" RowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                                <DataGridTextColumn Header="Typ" Binding="{Binding Direction}" Width="70" />
                                <DataGridTextColumn Header="Data Wejścia" Binding="{Binding EntryTime, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="130" />
                                <DataGridTextColumn Header="Cena Wejścia" Binding="{Binding EntryPrice, StringFormat=\{0:C2\}}" Width="100" />
                                <DataGridTextColumn Header="Data Wyjścia" Binding="{Binding ExitTime, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="130" />
                                <DataGridTextColumn Header="Cena Wyjścia" Binding="{Binding ExitPrice, StringFormat=\{0:C2\}}" Width="100" />
                                <DataGridTextColumn Header="Powód Wyjścia" Binding="{Binding ExitReason}" Width="120" />
                                <DataGridTextColumn Header="Zysk / Strata ($)" Binding="{Binding ProfitLoss, StringFormat=\{0:C2\}}" Width="110" />
                                <DataGridTextColumn Header="Zysk (%)" Binding="{Binding ProfitLossPercent, StringFormat=\{0:P2\}}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Zakładka 3: Podsumowanie i Sygnały -->
                    <TabItem Header="Analiza Pozycji &amp; Sygnały">
                        <ScrollViewer Padding="15">
                            <StackPanel>
                                <TextBlock Text="Statystyki Seriowości" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Średni Zysk z Wygranej:" Foreground="Gray"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AverageWin}" Foreground="#2E7D32" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Średnia Strata z Przegranej:" Foreground="Gray" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AverageLoss}" Foreground="#C62828" FontWeight="Bold" Margin="0,5,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Wygranych z Rzędu:" Foreground="Gray" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MaxConsecutiveWins}" FontWeight="Bold" Margin="0,5,0,0"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Max Przegranych z Rzędu:" Foreground="Gray" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MaxConsecutiveLosses}" FontWeight="Bold" Margin="0,5,0,0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Zakładka 4: Historia Backtestów -->
                    <TabItem Header="Historia Backtestów">
                        <DockPanel Margin="5">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                                <Button Content="Odśwież" Command="{Binding RefreshHistoryCommand}" Padding="10,3" Margin="0,0,5,0"/>
                                <Button Content="Pokaż wyniki" Command="{Binding OpenHistoryRunCommand}" Padding="10,3" Margin="0,0,5,0"/>
                                <Button Content="Porównaj zaznaczone" Command="{Binding CompareRunsCommand}"
                                        CommandParameter="{Binding SelectedItems, ElementName=HistoryGrid}"
                                        ToolTip="Zaznacz 2–8 zakończonych backtestów (Ctrl/Shift + klik)." Padding="10,3"/>
                            </StackPanel>
                            <DataGrid x:Name="HistoryGrid"
                                      ItemsSource="{Binding BacktestHistory}"
                                      SelectedItem="{Binding SelectedHistoryRun}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="White" RowHeight="26">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenHistoryRunCommand}" />
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Utworzono" Binding="{Binding CreatedAt.LocalDateTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="140" />
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="70" />
                                    <DataGridTextColumn Header="Strategia" Binding="{Binding StrategyName}" Width="130" />
                                    <DataGridTextColumn Header="Od" Binding="{Binding Start, StringFormat=\{0:yyyy-MM-dd\}}" Width="85" />
                                    <DataGridTextColumn Header="Do" Binding="{Binding End, StringFormat=\{0:yyyy-MM-dd\}}" Width="85" />
                                    <DataGridTextColumn Header="Kapitał" Binding="{Binding InitialCapital, StringFormat=\{0:N0\}}" Width="90" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85" />
                                    <DataGridTextColumn Header="Postęp" Binding="{Binding Progress, StringFormat=\{0\}%}" Width="60" />
                                    <DataGridTextColumn Header="Czas" Binding="{Binding Duration, StringFormat=hh\\:mm\\:ss}" Width="70" />
                                    <DataGridTextColumn Header="Błąd" Binding="{Binding FailureReason}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Zakładka 5: Porównanie backtestów (index = MainViewModel.ComparisonTabIndex) -->
                    <TabItem Header="Porównanie">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0" ItemsSource="{Binding ComparedRuns}"
                                      AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="24">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Run" Binding="{Binding RunId}" Width="*" />
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="65" />
                                    <DataGridTextColumn Header="Zysk netto" Binding="{Binding NetProfit}" Width="85" />
                                    <DataGridTextColumn Header="CAR" Binding="{Binding CompoundingAnnualReturn}" Width="80" />
                                    <DataGridTextColumn Header="Max DD" Binding="{Binding MaxDrawdown}" Width="75" />
                                    <DataGridTextColumn Header="Sharpe" Binding="{Binding SharpeRatio}" Width="65" />
                                    <DataGridTextColumn Header="Win Rate" Binding="{Binding WinRate}" Width="70" />
                                    <DataGridTextColumn Header="Profit Factor" Binding="{Binding ProfitFactor, StringFormat=0.00}" Width="85" />
                                    <DataGridTextColumn Header="Transakcje" Binding="{Binding TotalTrades}" Width="75" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <lvc:CartesianChart Grid.Row="1" Series="{Binding ComparisonSeries}" LegendLocation="Top" Margin="0,8,0,0">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Data" LabelFormatter="{Binding DayAxisFormatter}" />
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Skumulowana stopa zwrotu" LabelFormatter="{Binding PercentFormatter}" />
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </TabItem>

                    <!-- Zakładka 6: Zadania w tle -->
                    <TabItem Header="Zadania">
                        <DockPanel Margin="5">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                                <Button Content="Wyczyść zakończone" Command="{Binding ClearFinishedJobsCommand}" Padding="10,3"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Jobs}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="White" RowHeight="28">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Zadanie" Binding="{Binding Title}" Width="280" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                                    <DataGridTemplateColumn Header="Postęp" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2">
                                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="16" />
                                                    <TextBlock Text="{Binding Progress, StringFormat=\{0\}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Czas" Binding="{Binding Duration, StringFormat=hh\\:mm\\:ss}" Width="70" />
                                    <DataGridTextColumn Header="Komunikat" Binding="{Binding Message}" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Anuluj" Margin="2" Padding="6,0"
                                                        IsEnabled="{Binding IsActive}"
                                                        Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding Id}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Zakładka 7: Dane rynkowe zapisane lokalnie -->
                    <TabItem Header="Dane rynkowe">
                        <DockPanel Margin="5">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                                <Button Content="Odśwież" Command="{Binding RefreshCoverageCommand}" Padding="10,3"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding MarketDataCoverage}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="White" RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="70" />
                                    <DataGridTextColumn Header="Interwał" Binding="{Binding Timeframe}" Width="80" />
                                    <DataGridTextColumn Header="Dni" Binding="{Binding CoveredDays}" Width="60" />
                                    <DataGridTextColumn Header="Ostatnie pobranie" Binding="{Binding LastDownloadedAt.LocalDateTime, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="130" />
                                    <DataGridTextColumn Header="Zakresy" Binding="{Binding RangesText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ================= STATUSBAR ================= -->
        <StatusBar Grid.Row="1">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0" HorizontalContentAlignment="Stretch">
                <ProgressBar Value="{Binding CurrentProgress, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"
                             Height="16" />
            </StatusBarItem>

            <StatusBarItem Grid.Column="1">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>