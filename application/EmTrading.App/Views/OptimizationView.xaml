<UserControl x:Class="EmTrading.App.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EmTrading.Presentation.Localization;assembly=EmTrading.Presentation"
             xmlns:charts="clr-namespace:EmTrading.Wpf.Controls.Charts;assembly=EmTrading.Wpf.Controls"
             xmlns:controls="clr-namespace:EmTrading.Wpf.Controls;assembly=EmTrading.Wpf.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="LocalizedEnumItem">
            <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Inputs -->
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <ScrollViewer Style="{StaticResource FormScrollViewer}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Optimization_Title}" Style="{StaticResource PageTitle}" />

                    <TextBlock Text="{loc:Tr Field_Symbol}" Style="{StaticResource FieldLabel}" />
                    <controls:SymbolBox Text="{Binding Symbol}" SuggestionProvider="{StaticResource DownloadedSymbolSuggestions}"
                                        ToolTip="{loc:Tr Symbol_SearchHint}" AutomationProperties.Name="{loc:Tr Field_Symbol}" />

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,3,0">
                            <TextBlock Text="{loc:Tr Field_StartDate}" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding StartDate}" />
                        </StackPanel>
                        <StackPanel Margin="3,0,0,0">
                            <TextBlock Text="{loc:Tr Field_EndDate}" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding EndDate}" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="{loc:Tr Field_InitialCapital}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding InitialCapital, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{loc:Tr Field_Strategy}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}" DisplayMemberPath="DisplayName">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,3,0">
                            <TextBlock Text="{loc:Tr Optimization_Objective}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Objectives}" SelectedItem="{Binding Objective}" ItemTemplate="{StaticResource LocalizedEnumItem}" />
                        </StackPanel>
                        <StackPanel Margin="3,0,0,0">
                            <TextBlock Text="{loc:Tr Optimization_ParallelTrials}" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{loc:Tr Optimization_ParallelTrials}" />
                            <ComboBox ItemsSource="{Binding ParallelTrialOptions}" SelectedItem="{Binding MaxParallelTrials}" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="{loc:Tr Optimization_Parameters}" Style="{StaticResource SectionTitle}" Margin="0,14,0,2" />

                    <!-- One row per strategy parameter: a fixed value, or a range to vary. -->
                    <ItemsControl ItemsSource="{Binding Parameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,4" ToolTip="{Binding Description}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsVaried}" Content="{loc:Tr Optimization_Vary}"
                                                  VerticalAlignment="Center" AutomationProperties.Name="{Binding DisplayName}" />
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource FieldLabel}" />
                                    </DockPanel>

                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVaried}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <UniformGrid Columns="3" Visibility="{Binding IsVaried, Converter={StaticResource BooleanToVisibility}}">
                                        <StackPanel Margin="0,0,3,0">
                                            <TextBlock Text="{loc:Tr Optimization_From}" FontSize="10" Foreground="Gray" />
                                            <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="3,0,3,0">
                                            <TextBlock Text="{loc:Tr Optimization_To}" FontSize="10" Foreground="Gray" />
                                            <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="3,0,0,0">
                                            <TextBlock Text="{loc:Tr Optimization_Step}" FontSize="10" Foreground="Gray" />
                                            <TextBox Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource NegativeBrush}" FontSize="10" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding CombinationsText}" Foreground="Gray" Margin="0,8,0,0" />
                    <Button Content="{loc:Tr Optimization_Start}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"
                            Margin="0,10,0,4" ToolTip="{loc:Tr Optimization_StartHint}" />
                    <TextBlock Text="{loc:Tr Optimization_StartHint}" Foreground="Gray" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Optimizations and results -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="170" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="{loc:Tr Optimization_Runs}" Style="{StaticResource SectionTitle}" />

            <StackPanel Grid.Row="1" Style="{StaticResource Toolbar}">
                <Button Content="{loc:Tr Common_Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                <Button Content="{loc:Tr Optimization_CancelRun}" Command="{Binding CancelOptimizationCommand}" Margin="0,0,6,0" />
                <Button Content="{loc:Tr Optimization_ApplyBest}" Command="{Binding ApplyBestCommand}" Margin="0,0,6,0"
                        ToolTip="{loc:Tr Optimization_ApplyBestHint}" />
                <Button Content="{loc:Tr Optimization_OpenTrial}" Command="{Binding OpenTrialCommand}" />
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Optimizations}" SelectedItem="{Binding SelectedOptimization}" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr History_Created}" Binding="{Binding CreatedAt.LocalDateTime, StringFormat=g}" Width="125" />
                    <DataGridTextColumn Header="{loc:Tr Field_Symbol}" Binding="{Binding Symbol}" Width="60" />
                    <DataGridTextColumn Header="{loc:Tr Field_Strategy}" Binding="{Binding StrategyName}" Width="150" />
                    <DataGridTextColumn Header="{loc:Tr Optimization_Objective}" Binding="{Binding Objective, Converter={StaticResource LocalizedEnum}}" Width="130" />
                    <DataGridTextColumn Header="{loc:Tr History_Status}" Binding="{Binding Status, Converter={StaticResource LocalizedEnum}}" Width="90" />
                    <DataGridTemplateColumn Header="{loc:Tr Optimization_Trials}" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="16" />
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} / {1}">
                                                <Binding Path="FinishedTrials" />
                                                <Binding Path="TotalTrials" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Tr Optimization_BestScore}" Binding="{Binding BestScore, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="{loc:Tr History_Duration}" Binding="{Binding Duration, StringFormat=hh\\:mm\\:ss}" Width="70" />
                    <DataGridTextColumn Header="{loc:Tr History_Error}" Binding="{Binding FailureReason}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3" Text="{Binding BestText}" FontWeight="SemiBold" Margin="3,8,0,6" TextWrapping="Wrap" />

            <TabControl Grid.Row="4" Background="White" Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibility}}">
                <TabItem Header="{loc:Tr Optimization_TabHeatmap}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,6,4,4">
                            <TextBlock Text="{loc:Tr Optimization_XAxis}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Axes}" SelectedItem="{Binding XAxis}" DisplayMemberPath="DisplayName" Width="170"
                                      AutomationProperties.Name="{loc:Tr Optimization_XAxis}" />
                            <TextBlock Text="{loc:Tr Optimization_YAxis}" VerticalAlignment="Center" Margin="14,0,6,0" />
                            <ComboBox ItemsSource="{Binding Axes}" SelectedItem="{Binding YAxis}" DisplayMemberPath="DisplayName" Width="170"
                                      AutomationProperties.Name="{loc:Tr Optimization_YAxis}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{loc:Tr Optimization_HeatmapHint}" Foreground="Gray" FontSize="10" Margin="4" TextWrapping="Wrap" />
                        <charts:HeatmapChart Data="{Binding Heatmap}" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="{loc:Tr Optimization_TabTrials}">
                    <DataGrid ItemsSource="{Binding Trials}" SelectedItem="{Binding SelectedTrial}" SelectionMode="Single">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenTrialCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                            <DataGridTextColumn Header="{loc:Tr Optimization_Point}" Binding="{Binding PointText}" Width="220" />
                            <DataGridTextColumn Header="{loc:Tr History_Status}" Binding="{Binding Status, Converter={StaticResource LocalizedEnum}}" Width="85" />
                            <DataGridTextColumn Header="{loc:Tr Optimization_Score}" Binding="{Binding Score, StringFormat=N3}" Width="70" />
                            <DataGridTextColumn Header="{loc:Tr Kpi_NetProfit}" Binding="{Binding Metrics.NetProfitPercent, StringFormat=\{0:N2\}%}" Width="85" />
                            <DataGridTextColumn Header="{loc:Tr Kpi_MaxDrawdown}" Binding="{Binding Metrics.MaxDrawdownPercent, StringFormat=\{0:N2\}%}" Width="85" />
                            <DataGridTextColumn Header="{loc:Tr Kpi_Sharpe}" Binding="{Binding Metrics.SharpeRatio, StringFormat=N2}" Width="60" />
                            <DataGridTextColumn Header="{loc:Tr Kpi_Trades}" Binding="{Binding Metrics.TotalTrades}" Width="60" />
                            <DataGridTextColumn Header="{loc:Tr Kpi_WinRate}" Binding="{Binding Metrics.WinRatePercent, StringFormat=\{0:N1\}%}" Width="70" />
                            <DataGridTextColumn Header="{loc:Tr Kpi_ProfitFactor}" Binding="{Binding Metrics.ProfitFactor, StringFormat=N2}" Width="80" />
                            <DataGridTextColumn Header="{loc:Tr History_Error}" Binding="{Binding FailureReason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
