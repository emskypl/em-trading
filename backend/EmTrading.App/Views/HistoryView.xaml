<UserControl x:Class="EmTrading.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EmTrading.Presentation.Localization;assembly=EmTrading.Presentation"
             xmlns:charts="clr-namespace:EmTrading.Wpf.Controls.Charts;assembly=EmTrading.Wpf.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Tr History_Title}" Style="{StaticResource PageTitle}" />

        <StackPanel Grid.Row="1" Style="{StaticResource Toolbar}">
            <Button Content="{loc:Tr Common_Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
            <Button Content="{loc:Tr History_Open}" Command="{Binding OpenRunCommand}" Margin="0,0,6,0" />
            <Button Content="{loc:Tr History_Compare}" Command="{Binding CompareCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=HistoryGrid}" ToolTip="{loc:Tr History_CompareHint}" />
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="HistoryGrid" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" SelectionMode="Extended">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenRunCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr History_Created}" Binding="{Binding CreatedAt.LocalDateTime, StringFormat=g}" Width="130" />
                <DataGridTextColumn Header="{loc:Tr Field_Symbol}" Binding="{Binding Symbol}" Width="70" />
                <DataGridTextColumn Header="{loc:Tr Field_Strategy}" Binding="{Binding StrategyName}" Width="170" />
                <DataGridTextColumn Header="{loc:Tr Field_StartDate}" Binding="{Binding Start, StringFormat=d}" Width="90" />
                <DataGridTextColumn Header="{loc:Tr Field_EndDate}" Binding="{Binding End, StringFormat=d}" Width="90" />
                <DataGridTextColumn Header="{loc:Tr Field_InitialCapital}" Binding="{Binding InitialCapital, StringFormat=N0}" Width="100" />
                <DataGridTextColumn Header="{loc:Tr History_Status}" Binding="{Binding Status, Converter={StaticResource LocalizedEnum}}" Width="100" />
                <DataGridTextColumn Header="{loc:Tr History_Progress}" Binding="{Binding Progress, StringFormat=\{0\}%}" Width="60" />
                <DataGridTextColumn Header="{loc:Tr History_Duration}" Binding="{Binding Duration, StringFormat=hh\\:mm\\:ss}" Width="70" />
                <DataGridTextColumn Header="{loc:Tr History_Error}" Binding="{Binding FailureReason}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent"
                      Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibility}}" />

        <Border Grid.Row="4" Style="{StaticResource Card}" Height="380"
                Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:Tr Comparison_Title}" Style="{StaticResource SectionTitle}" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding ComparedRuns}" MaxHeight="150">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Run" Binding="{Binding RunId}" Width="*" />
                        <DataGridTextColumn Header="{loc:Tr Field_Symbol}" Binding="{Binding Symbol}" Width="65" />
                        <DataGridTextColumn Header="{loc:Tr Kpi_NetProfit}" Binding="{Binding NetProfit}" Width="90" />
                        <DataGridTextColumn Header="{loc:Tr Kpi_AnnualReturn}" Binding="{Binding CompoundingAnnualReturn}" Width="100" />
                        <DataGridTextColumn Header="{loc:Tr Kpi_MaxDrawdown}" Binding="{Binding MaxDrawdown}" Width="80" />
                        <DataGridTextColumn Header="{loc:Tr Kpi_Sharpe}" Binding="{Binding SharpeRatio}" Width="70" />
                        <DataGridTextColumn Header="{loc:Tr Kpi_WinRate}" Binding="{Binding WinRate}" Width="70" />
                        <DataGridTextColumn Header="{loc:Tr Kpi_ProfitFactor}" Binding="{Binding ProfitFactor, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="{loc:Tr Kpi_Trades}" Binding="{Binding TotalTrades}" Width="75" />
                    </DataGrid.Columns>
                </DataGrid>
                <charts:MultiSeriesChart Grid.Row="2" Series="{Binding ComparisonSeries}" ShowPercent="True"
                                         ValueLabel="{loc:Tr Chart_CumulativeReturn}" Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
