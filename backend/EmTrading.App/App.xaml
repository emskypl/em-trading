<Application x:Class="EmTrading.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EmTrading.App.Views"
             xmlns:backtesting="clr-namespace:EmTrading.Presentation.Backtesting;assembly=EmTrading.Presentation"
             xmlns:marketData="clr-namespace:EmTrading.Presentation.MarketData;assembly=EmTrading.Presentation"
             xmlns:jobs="clr-namespace:EmTrading.Presentation.Jobs;assembly=EmTrading.Presentation"
             xmlns:logs="clr-namespace:EmTrading.Presentation.Logging;assembly=EmTrading.Presentation"
             xmlns:settings="clr-namespace:EmTrading.Presentation.Settings;assembly=EmTrading.Presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- View-model-first navigation: the shell shows a page view model, WPF picks its view here. -->
            <DataTemplate DataType="{x:Type backtesting:BacktestViewModel}"><views:BacktestView /></DataTemplate>
            <DataTemplate DataType="{x:Type backtesting:HistoryViewModel}"><views:HistoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type marketData:MarketDataViewModel}"><views:MarketDataView /></DataTemplate>
            <DataTemplate DataType="{x:Type jobs:JobsViewModel}"><views:JobsView /></DataTemplate>
            <DataTemplate DataType="{x:Type logs:LogsViewModel}"><views:LogsView /></DataTemplate>
            <DataTemplate DataType="{x:Type settings:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
