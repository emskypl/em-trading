<UserControl x:Class="EmTrading.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EmTrading.Presentation.Localization;assembly=EmTrading.Presentation">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Logs_Title}" Style="{StaticResource PageTitle}" />
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
            <TextBlock Text="{loc:Tr Logs_MinimumLevel}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding MinimumLevel}" Width="130" Margin="0,0,12,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{loc:Tr Logs_Clear}" Command="{Binding ClearCommand}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Entries}" FontFamily="Consolas" FontSize="12" RowHeight="22"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr Logs_Time}" Binding="{Binding Time.LocalDateTime, StringFormat=HH:mm:ss.fff}" Width="95" />
                <DataGridTextColumn Header="{loc:Tr Logs_Level}" Binding="{Binding Level, Converter={StaticResource LocalizedEnum}}" Width="90" />
                <DataGridTextColumn Header="{loc:Tr Logs_Source}" Binding="{Binding Source}" Width="220" />
                <DataGridTextColumn Header="{loc:Tr Jobs_Message}" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
