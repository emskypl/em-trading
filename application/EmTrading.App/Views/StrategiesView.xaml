<UserControl x:Class="EmTrading.App.Views.StrategiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EmTrading.Presentation.Localization;assembly=EmTrading.Presentation">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Strategy list -->
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Strategies_Title}" Style="{StaticResource PageTitle}" />
                <ListBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,6" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Converter={StaticResource StrategyText}}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Converter={StaticResource StrategyText}, ConverterParameter=Description}"
                                           TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Selected strategy -->
        <ScrollViewer Grid.Column="1" Style="{StaticResource FormScrollViewer}">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="{loc:Tr Strategies_TryInBacktest}" Command="{Binding TryInBacktestCommand}" Margin="0,0,6,0" />
                        <Button Content="{loc:Tr Strategies_Optimize}" Command="{Binding OptimizeCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedStrategy, Converter={StaticResource StrategyText}}" Style="{StaticResource PageTitle}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SelectedStrategy.Name}" Foreground="Gray" FontSize="11" />
                    </StackPanel>
                </DockPanel>

                <!-- Description sections; keys come from data, so they go through LocalizeKey to follow language changes. -->
                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocalizeKey}">
                                                <Binding Path="TitleKey" />
                                                <Binding Path="Culture" Source="{x:Static loc:Loc.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocalizeKey}">
                                                <Binding Path="Key" />
                                                <Binding Path="Culture" Source="{x:Static loc:Loc.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Parameters -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Strategies_Parameters}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{loc:Tr Strategies_SuggestedHint}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6" />
                        <!-- Rows grow with the wrapped descriptions instead of the app's fixed row height. -->
                        <DataGrid ItemsSource="{Binding Parameters}" HeadersVisibility="Column" RowHeight="NaN" MinRowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr Strategies_Parameter}" Binding="{Binding DisplayName}" Width="170" />
                                <DataGridTextColumn Header="{loc:Tr Strategies_Meaning}" Binding="{Binding Description}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{loc:Tr Strategies_Default}" Binding="{Binding Default}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Tr Strategies_Allowed}" Binding="{Binding Allowed}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Tr Strategies_Suggested}" Binding="{Binding Suggested}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Best parameters found by the user's optimizations -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Strategies_BestResults}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{loc:Tr Strategies_BestResultsHint}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Tr Strategies_NoResults}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBestResults}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding BestResults}" MaxHeight="420" RowHeight="NaN" MinRowHeight="30"
                                  Visibility="{Binding HasBestResults, Converter={StaticResource BooleanToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{loc:Tr Strategies_UseInBacktest}" Padding="8,2" MinHeight="0" Margin="2" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.UseInBacktestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr Field_Symbol}" Binding="{Binding Symbol}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Tr Field_StartDate}" Binding="{Binding Start, StringFormat=d}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Tr Field_EndDate}" Binding="{Binding End, StringFormat=d}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Tr Optimization_Score}" Binding="{Binding Score, StringFormat=N2}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Tr Compare_NetProfit}" Binding="{Binding Metrics.NetProfitPercent, StringFormat=N2}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Tr Compare_MaxDrawdown}" Binding="{Binding Metrics.MaxDrawdownPercent, StringFormat=N2}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Tr Kpi_Sharpe}" Binding="{Binding Metrics.SharpeRatio, StringFormat=N2}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Tr Kpi_Trades}" Binding="{Binding Metrics.TotalTrades}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Tr Optimization_Objective}" Binding="{Binding Objective, Converter={StaticResource LocalizedEnum}}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Tr Strategies_Values}" Binding="{Binding ParametersText}" Width="*" MinWidth="220">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
