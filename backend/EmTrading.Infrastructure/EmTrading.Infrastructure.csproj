<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- EF Core Design (dotnet ef, private) brings Roslyn 5.0 while Lean pins 4.8. Only this project's design-time graph
         is affected: the app and engine runner outputs still ship Roslyn 4.8. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmTrading.Application\EmTrading.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="QuantConnect.Algorithm" />
    <PackageReference Include="QuantConnect.Common" />
    <PackageReference Include="QuantConnect.Lean" />
    <PackageReference Include="QuantConnect.Lean.Engine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmTrading.Infrastructure.Tests" />
  </ItemGroup>

</Project>
