<UserControl x:Class="EmTrading.App.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EmTrading.Presentation.Localization;assembly=EmTrading.Presentation"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <!-- Read-only text boxes so answers can be selected and copied. -->
        <Style x:Key="MessageText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1000" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:Tr Assistant_NewChat}" Command="{Binding NewChatCommand}" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="{loc:Tr Assistant_Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,2" />
                <TextBlock Foreground="Gray" FontSize="11" Margin="0,0,0,10">
                    <Run Text="{loc:Tr Assistant_Model}" /> <Run Text="{Binding Model, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Shown until an API key is entered in Settings. -->
        <Border Grid.Row="1" Margin="0,0,0,10" Background="#FFF6DD" CornerRadius="6" Padding="12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Tr Assistant_OpenSettings}" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Tr Assistant_NoKey}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <TextBlock Text="{loc:Tr Assistant_Intro}" TextWrapping="Wrap" Foreground="Gray" Margin="8" LineHeight="20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer x:Name="Scroller" Style="{StaticResource FormScrollViewer}" ScrollChanged="OnScrollChanged">
                    <ItemsControl ItemsSource="{Binding Messages}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Bubble" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" MaxWidth="760"
                                        HorizontalAlignment="Left" Background="#F4F5F7">
                                    <StackPanel>
                                        <TextBox x:Name="Body" Text="{Binding Text, Mode=OneWay}" Style="{StaticResource MessageText}" />
                                        <TextBlock x:Name="Typing" Text="…" Foreground="Gray" Visibility="Collapsed" />
                                        <Button x:Name="OpenTrading" Content="{loc:Tr Assistant_OpenTrading}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Command="{Binding DataContext.OpenTradingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="Background" Value="#E3EEFB" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsProposal}" Value="True">
                                        <Setter TargetName="Bubble" Property="Background" Value="#FFF6DD" />
                                        <Setter TargetName="OpenTrading" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="Body" Property="Foreground" Value="{StaticResource NegativeBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                        <Setter TargetName="Typing" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Activity}" Foreground="Gray" FontStyle="Italic" Margin="2,6,0,0" />

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:Tr Assistant_Stop}" Command="{Binding StopCommand}" Margin="6,0,0,0" MinWidth="80" />
            <Button DockPanel.Dock="Right" Content="{loc:Tr Assistant_Send}" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" MinWidth="100" />
            <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                     ToolTip="{loc:Tr Assistant_InputHint}" AutomationProperties.Name="{loc:Tr Assistant_InputHint}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
    </Grid>
</UserControl>
