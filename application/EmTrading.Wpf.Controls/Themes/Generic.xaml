<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EmTrading.Wpf.Controls">

    <Style TargetType="{x:Type local:KpiCard}">
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:KpiCard}">
                    <Border Background="White" CornerRadius="5" Padding="10,8" BorderBrush="#E0E0E3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Title}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{TemplateBinding Value}" FontSize="18" FontWeight="Bold" Foreground="{TemplateBinding Accent}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:SymbolBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SymbolBox}">
                    <Grid>
                        <!-- Looks like an editable ComboBox: the text box and the arrow share one border. -->
                        <Border x:Name="Frame" Background="White" BorderBrush="#ABADB3" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PART_TextBox" BorderThickness="0" Background="Transparent"
                                         Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                                <Button x:Name="PART_DropDownButton" Grid.Column="1" Width="22" Focusable="False" IsTabStop="False" Cursor="Arrow">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Area" Background="Transparent">
                                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Area" Property="Background" Value="#E5F1FB" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Area" Property="Background" Value="#CCE4F7" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=Frame}" Placement="Bottom"
                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="None"
                               MinWidth="{Binding ActualWidth, ElementName=Frame}">
                            <Border Background="White" BorderBrush="#C8C8CC" BorderThickness="1" Margin="0,1,6,6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <ListBox x:Name="PART_List" MaxHeight="320" MinWidth="280" BorderThickness="0" Focusable="False"
                                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Padding" Value="6,3" />
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Symbol}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:SymbolSuggestion}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="Gray" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#7EB4EA" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#569DE5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
