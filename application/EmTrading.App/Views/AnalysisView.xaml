<UserControl x:Class="EmTrading.App.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EmTrading.Presentation.Localization;assembly=EmTrading.Presentation"
             xmlns:controls="clr-namespace:EmTrading.Wpf.Controls;assembly=EmTrading.Wpf.Controls"
             xmlns:charts="clr-namespace:EmTrading.Wpf.Controls.Charts;assembly=EmTrading.Wpf.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Inputs -->
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <ScrollViewer Style="{StaticResource FormScrollViewer}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Analysis_Title}" Style="{StaticResource PageTitle}" />

                    <TextBlock Text="{loc:Tr Analysis_Run}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Symbol, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="·" />
                                    <Run Text="{Binding RunId, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding RunId}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Text="{loc:Tr Analysis_NoRun}" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRun}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{loc:Tr Analysis_Simulations}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding SimulationOptions}" SelectedItem="{Binding Simulations}" ItemStringFormat="N0" />

                    <TextBlock Text="{loc:Tr Analysis_Method}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{loc:Tr Analysis_Seed}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="{loc:Tr Analysis_Analyze}" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,8" />
                    <TextBlock Text="{loc:Tr Analysis_MethodHint}" Foreground="Gray" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Results -->
        <Grid Grid.Column="1" Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding ComputeInfo}" Foreground="Gray" Margin="3,0,0,6" />

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
                <controls:KpiCard Title="{loc:Tr Analysis_ProbabilityOfLoss}" Value="{Binding MonteCarlo.ProbabilityOfLossPercent, StringFormat=\{0:N1\}%}"
                                  Accent="{StaticResource NegativeBrush}" />
                <controls:KpiCard Title="{loc:Tr Analysis_MedianDrawdown}" Value="{Binding MonteCarlo.MaxDrawdownPercent.P50, StringFormat=\{0:N2\}%}"
                                  Accent="{StaticResource AccentBrush}" />
                <controls:KpiCard Title="{loc:Tr Analysis_Drawdown95}" Value="{Binding MonteCarlo.MaxDrawdownPercent.P95, StringFormat=\{0:N2\}%}"
                                  Accent="{StaticResource NegativeBrush}" />
                <controls:KpiCard Title="{loc:Tr Analysis_HistoricalDrawdown}" Value="{Binding MonteCarlo.OriginalMaxDrawdownPercent, StringFormat=\{0:N2\}%}" />
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Analysis_Percentiles}" Style="{StaticResource SectionTitle}" />
                    <DataGrid ItemsSource="{Binding Percentiles}" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr Analysis_Statistic}" Binding="{Binding Label}" Width="*" />
                            <DataGridTextColumn Header="P5" Binding="{Binding P5, StringFormat=\{0:N2\}%}" Width="80" />
                            <DataGridTextColumn Header="P25" Binding="{Binding P25, StringFormat=\{0:N2\}%}" Width="80" />
                            <DataGridTextColumn Header="P50" Binding="{Binding P50, StringFormat=\{0:N2\}%}" Width="80" />
                            <DataGridTextColumn Header="P75" Binding="{Binding P75, StringFormat=\{0:N2\}%}" Width="80" />
                            <DataGridTextColumn Header="P95" Binding="{Binding P95, StringFormat=\{0:N2\}%}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="3" Background="White">
                <TabItem Header="{loc:Tr Analysis_TabPaths}">
                    <charts:XYSeriesChart Series="{Binding Paths}" XLabel="{loc:Tr Analysis_TradeNumber}" YLabel="{loc:Tr Chart_Equity}" />
                </TabItem>
                <TabItem Header="{loc:Tr Analysis_TabDistribution}">
                    <charts:HistogramChart Bars="{Binding DrawdownDistribution}" ShowPercent="True"
                                           ValueLabel="{loc:Tr Analysis_MaxDrawdown}" CountLabel="{loc:Tr Analysis_Simulations}"
                                           ReferenceValue="{Binding HistoricalDrawdown}" ReferenceLabel="{loc:Tr Analysis_HistoricalDrawdown}" />
                </TabItem>
                <TabItem Header="{loc:Tr Analysis_TabDrawdowns}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                            <TextBlock Text="{loc:Tr Kpi_MaxDrawdown}" Foreground="Gray" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Drawdowns.MaxDrawdownPercent, StringFormat=\{0:N2\}%}" FontWeight="Bold" Margin="0,0,24,0" />
                            <TextBlock Text="{loc:Tr Analysis_TimeUnderwater}" Foreground="Gray" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Drawdowns.TimeUnderwaterPercent, StringFormat=\{0:N1\}%}" FontWeight="Bold" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Drawdowns.Periods}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr Analysis_Depth}" Binding="{Binding DepthPercent, StringFormat=\{0:N2\}%}" Width="80" />
                                <DataGridTextColumn Header="{loc:Tr Analysis_Peak}" Binding="{Binding PeakTime, StringFormat=d}" Width="100" />
                                <DataGridTextColumn Header="{loc:Tr Analysis_Trough}" Binding="{Binding TroughTime, StringFormat=d}" Width="100" />
                                <DataGridTextColumn Header="{loc:Tr Analysis_Recovered}" Binding="{Binding RecoveredAt, StringFormat=d}" Width="100" />
                                <DataGridTextColumn Header="{loc:Tr Analysis_DeclineDays}" Binding="{Binding Decline.TotalDays, StringFormat=N0}" Width="110" />
                                <DataGridTextColumn Header="{loc:Tr Analysis_RecoveryDays}" Binding="{Binding Recovery.TotalDays, StringFormat=N0}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
